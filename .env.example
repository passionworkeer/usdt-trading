# ============================================
# v8.0 AI Agent 双轨架构配置（最小化纯净模板）
# ============================================

# ==================== Binance API ====================
# 必填：Binance API Key（只交易权限，禁止提现）
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_secret

# 是否使用测试网（开发时 true，实盘 false）
BINANCE_TESTNET=true

# ==================== 交易参数 ====================
# 总资金（USDT）
CAPITAL=200

# Dry-Run 模式（模拟运行，不实际下单）
# 开发时 true，实盘 false
DRY_RUN=true

# ==================== v8.0 AI Agent 配置 ====================
# 是否启用 AI Agent（宏观大局观 + 微观审批）
ENABLE_AI_AGENT=true

# Anthropic API Key（Claude AI）
# 获取方式：https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key

# Twitter API Bearer Token（可选，用于情绪分析）
# 如果没有，系统仍然可以运行（跳过 Twitter 情绪分析）
# 获取方式：https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# ==================== Telegram 预警（可选）====================
# 获取方式：在 Telegram 中找到 @BotFather，创建新 Bot
TELEGRAM_BOT_TOKEN=

# 获取方式：在 Telegram 中找到 @userinfobot，获取 Chat ID
TELEGRAM_CHAT_ID=

# ==================== Discord 预警（可选）====================
# 获取方式：Discord 服务器设置 → 整合 → Webhook
DISCORD_WEBHOOK_URL=

# ==================== 高级参数（可选）====================
# 检查间隔（分钟）
# CHECK_INTERVAL=15

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO
